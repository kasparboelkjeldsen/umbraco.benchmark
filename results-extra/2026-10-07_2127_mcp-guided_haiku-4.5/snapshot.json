                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "content",
                    "value": {
                      "markup": "<h2>What is MCP?</h2><p>Model Context Protocol is an open standard that enables AI models to interact with external systems, APIs, and data sources in a structured and safe way. It provides a standardized interface for models to request information, execute actions, and receive feedback.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "94546918-2c2b-4358-a800-c6c2399d0d08",
                "key": "fa979dd2-adbd-4d74-802c-ec5ca7d7591d",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "message",
                    "value": {
                      "markup": "<p><strong>Key Benefit:</strong> MCP enables seamless integration between AI systems and enterprise applications without complex middleware.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
