              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
