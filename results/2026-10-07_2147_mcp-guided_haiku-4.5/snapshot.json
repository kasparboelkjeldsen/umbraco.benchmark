                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Your workflow is unique. Whether you're managing content, orchestrating AI tasks, or building complex applications, MCP adapts to your needs. It's built on principles of extensibility and open standards.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
