                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "7acda0a0-a908-40f0-91ff-da3bde98c070",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "1ccc13e5-c11f-4235-ac23-1efaa93dd422",
                "key": "05948587-61bb-4a67-a4af-077de0f41d26",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Model Context Protocol (MCP) is revolutionizing how AI systems interact with external tools and services. It provides a standardized way for AI models to request and utilize real-world capabilities, making interactions more intelligent and context-aware.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "e5a20ed4-bf00-45f1-859c-fb57eb637faa",
                "key": "e1d61891-c22f-4f95-a69a-b3085ddab799",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "e5d2a7c4-6b9e-4d1c-8f2a-7b3c1d9e5f8a",
                        "mediaKey": "2ede4092-3ed0-4a21-89dc-ce816ec6268b",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Abstract network visualization"
                  }
                ]
              },
              {
                "contentTypeKey": "1ccc13e5-c11f-4235-ac23-1efaa93dd422",
                "key": "c03af102-5186-495f-9879-41aac6b5207a",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>With MCP, developers can build more capable AI applications that understand context and make better decisions. The protocol abstracts away complexity while providing rich integration capabilities that scale across your entire application ecosystem.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "442b78a3-9da6-446f-89ba-5afe07d0b384",
                "key": "7acda0a0-a908-40f0-91ff-da3bde98c070",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "MCP is transforming how AI systems interact with the real world, one protocol at a time."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "author",
                    "value": "AI Enthusiasts"
                  }
                ]
              }
            ],
