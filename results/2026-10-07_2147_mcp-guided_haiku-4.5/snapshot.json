                "key": "9218e90b-3d16-4f02-9c1c-025a09991ace",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>From content creation to system integration, MCP provides intelligent context that helps every tool in your ecosystem work smarter. The result is faster development, fewer errors, and more powerful applications.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
