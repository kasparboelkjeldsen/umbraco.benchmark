      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is Awesome"
        },
        {
          "editorAlias": "Umbraco.RichText",
          "culture": null,
          "segment": null,
          "alias": "date",
          "value": {
            "markup": "2026-10-07",
            "blocks": {
              "layout": {},
              "contentData": [],
              "settingsData": [],
              "expose": []
            }
          }
        },
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "MCP (Model Context Protocol) enables seamless integration between AI systems and external tools."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "e5d2a7c4-6b9e-4d1c-8f2a-7b3c1d9e5f8a",
