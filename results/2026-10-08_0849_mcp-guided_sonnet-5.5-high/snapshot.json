    {
      "id": "1a88259f-4e08-4cdf-b890-cad7b3a16e9a",
      "name": "Why MCP is awesome: your CMS becomes a colleague",
      "path": "WWW / Blog / Why MCP is awesome: your CMS becomes a colleague",
      "docTypeId": "c7a5b5dd-fafc-4c11-ac4e-14a8e7bfddb6",
      "templateId": "1b139464-b8d3-4af9-bb18-32444b276563",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is awesome: your CMS becomes a colleague"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-05 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "With MCP, an assistant can model content, upload media and publish pages through the same safe tools an editor would use."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "c2d1a7b3-4e65-4f1c-8b2f-6a8d3e9f5b02",
              "mediaKey": "2a224966-a530-48de-ba95-a02c8a175b18",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "a2b3c4f9-c299-43c6-abd5-c37e3ce04615",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "90a3d53f-7707-4e76-a521-b83be3f2ca69",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "6160b837-8690-47a9-a449-b2ed5ad119a4",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "5eb3e0eb-a11a-42a2-b03c-df6fadde5f83",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "25b8da17-11eb-42e9-80f2-0df90950e32f",
                "key": "a2b3c4f9-c299-43c6-abd5-c37e3ce04615",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "content",
                    "value": {
                      "markup": "<h2>From chatbot to teammate</h2><p>A chatbot can only talk about your website. An assistant with MCP access can actually work on it: inspect the content model, create a page, upload an image and publish the result.</p><p>That shift, from describing work to doing it, is what makes MCP such a big deal for content teams.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "f772eec5-bfe2-44ca-844a-a1fecadfeed2",
                "key": "90a3d53f-7707-4e76-a521-b83be3f2ca69",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "e4f3c9d5-6a87-4b3e-8d41-8c0f5a1b7d04",
                        "mediaKey": "68be03ce-3aef-4308-b9e1-7b7f3c6ac363",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "The right piece fits the right slot. Photo: Edge2Edge Media on Unsplash."
                  }
                ]
              },
              {
                "contentTypeKey": "9dd71444-0933-4e01-8924-6db6f5a91f4d",
                "key": "6160b837-8690-47a9-a449-b2ed5ad119a4",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "The assistant doesn't get a back door. It gets the same front door as everyone else."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
