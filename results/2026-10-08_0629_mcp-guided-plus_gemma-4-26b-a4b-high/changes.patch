diff --git a/Umbraco.Bench.Umbraco/Views/blogPostTemplate.cshtml b/Umbraco.Bench.Umbraco/Views/blogPostTemplate.cshtml
new file mode 100644
index 0000000..0be3e33
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogPostTemplate.cshtml
@@ -0,0 +1,13 @@
+﻿@inherits UmbracoViewPage<Umbraco.Cms.Web.Common.Models.PublishedContent>
+<div class="container mx-auto px-4 py-8">
+    <article>
+        <h1 class="text-4xl font-bold mb-4">@Model.Name</h1>
+        @if (Model.Value<IPublishedContent>("image") != null)
+        {
+            <img src="@Model.Value<IPublishedContent>("image").GetCropUrl(width: 1200)" class="w-full h-64 object-cover mb-8 rounded-lg" />
+        }
+        <div class="prose prose-lg max-w-none">
+            @await Html.GetBlockGridHtmlAsync(Model, "bodyContent")
+        </div>
+    </article>
+</div>
\ No newline at end of file
