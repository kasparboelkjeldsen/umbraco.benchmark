    {
      "id": "071e0481-3650-4f7d-97f6-36ff4b1eb8d6",
      "name": "Why MCP is Awesome",
      "path": "WWW / Blog / Why MCP is Awesome",
      "docTypeId": "9084a58d-99f2-4576-8b1a-b77f29725c81",
      "templateId": "e0dd05d7-3b6b-413d-9277-084e95b5d1c0",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is Awesome"
        },
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "date",
          "value": "October 7, 2026"
        },
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "MCP standardizes how AI models interact with external systems, making integration seamless and powerful."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "a7ce3dbf-8255-43e9-b5a1-a8b0fc18a43d",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "6ebbc882-e4b4-4031-99fc-7b3387dbfa3e",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "6f6235d4-d064-4d3f-813f-fc844e75b873",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "8de91183-c157-47a2-81e9-7e96206a35d2",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "7903dd9f-d0c3-4726-96c0-35ae9ca775bf",
                "key": "a7ce3dbf-8255-43e9-b5a1-a8b0fc18a43d",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Model Context Protocol (MCP) represents a paradigm shift in how AI systems interact with external tools and data. At its core, MCP provides a standardized interface that allows language models to seamlessly access external resources without proprietary integrations.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "eb00cb37-ae89-4b94-ac95-d7f6647832d0",
                "key": "6ebbc882-e4b4-4031-99fc-7b3387dbfa3e",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "content",
                    "value": {
                      "markup": "<p><strong>Key benefits of MCP:</strong> Reduces vendor lock-in, enables consistent tool integration across different AI platforms, and provides developers with a cleaner architecture for building AI applications.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "12ac0495-e4cc-430a-ae64-be0bd86d7138",
                "key": "6f6235d4-d064-4d3f-813f-fc844e75b873",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "a7c3e9b1-2f5a-4d8e-9c1b-6a3e7f2d5c8a",
                        "mediaKey": "99a16f90-b784-40dc-9558-875c81e08296",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": {
                      "markup": "<p>Circuit board symbolizing connected systems</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "7903dd9f-d0c3-4726-96c0-35ae9ca775bf",
                "key": "8de91183-c157-47a2-81e9-7e96206a35d2",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>By using MCP, developers can focus on their core business logic while the protocol handles the complexity of tool integration. This leads to more maintainable, flexible, and scalable AI applications.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "a7ce3dbf-8255-43e9-b5a1-a8b0fc18a43d",
                "culture": null,
                "segment": null
              },
