# .gitignore for the umbraco.benchmark repo (tools/Push-Benchmark.ps1 puts it there).
# Machine state, recreated per machine: the baseline repo (npm run baseline), settings for one machine only
bench/.baseline-git/
run-book.local.json
# The runner's raw per-run streams: every run folder keeps its own copy
bench/logs/auto-*.jsonl
# Build output and Umbraco's runtime data
node_modules/
bin/
obj/
.vs/
**/umbraco/Data/
**/umbraco/Logs/
**/umbraco/mediacache/
**/wwwroot/media/
