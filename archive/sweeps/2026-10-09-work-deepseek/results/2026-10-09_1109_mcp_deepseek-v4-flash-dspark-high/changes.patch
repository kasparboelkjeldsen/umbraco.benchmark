@@ -0,0 +1,35 @@
+@using Umbraco.Cms.Web.Common.PublishedModels;
+@using Umbraco.Bench.Umbraco.Models;
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlogFrontPage>
+@{
+    Layout = null;
+    var site = Umbraco.ContentAtRoot().FirstOrDefault();
+}
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@(Model.PageTitle ?? "Blog")</title>
+    <script src="https://cdn.tailwindcss.com"></script>
+</head>
+<body class="bg-gray-50 text-gray-900 antialiased">
+    <!-- DEBUG: Blocks available: @(Model.Blocks != null ? Model.Blocks.Count().ToString() : "null") -->
+    @if (Model.Blocks != null && Model.Blocks.Any())
+    {
+        @await Html.PartialAsync("blockgrid/default", Model.Blocks)
+    }
+    else
+    {
+        <div class="max-w-6xl mx-auto px-4 py-8">
+            <p class="text-gray-500">No blocks to display.</p>
+        </div>
+    }
+
+    <footer class="border-t border-gray-200 py-8 text-center text-sm text-gray-500 mt-16">
+        <div class="max-w-6xl mx-auto px-4">
+            <p>Built with Umbraco 18 &amp; the MCP protocol &mdash; all content created through the Umbraco MCP server.</p>
+        </div>
+    </footer>
+</body>
+</html>
diff --git a/Umbraco.Bench.Umbraco/Views/blogPost.cshtml b/Umbraco.Bench.Umbraco/Views/blogPost.cshtml
new file mode 100644
index 0000000..2d9ee76
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogPost.cshtml
@@ -0,0 +1,68 @@
+@using Umbraco.Cms.Web.Common.PublishedModels;
+@using Umbraco.Bench.Umbraco.Models;
+@using Umbraco.Cms.Core.Models;
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlogPost>
+@{
+    Layout = null;
+}
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@(Model.PageTitle ?? Model.Name)</title>
+    <script src="https://cdn.tailwindcss.com"></script>
+</head>
+<body class="bg-gray-50 text-gray-900 antialiased">
+    <article class="max-w-4xl mx-auto px-4 py-12">
+        <header class="mb-10">
+            @if (Model.FeaturedImage != null)
+            {
+                var src = Model.FeaturedImage.GetCropUrl(1200, 600);
+                if (src != null)
+                {
+                    <img src="@src" alt="@Model.PageTitle" class="w-full h-72 object-cover rounded-xl mb-8 shadow-md" />
+                }
+            }
+
+            <h1 class="text-4xl font-bold text-gray-900 mb-3">@(Model.PageTitle ?? Model.Name)</h1>
+
+            <div class="flex items-center gap-4 text-sm text-gray-500">
+                @if (!string.IsNullOrEmpty(Model.Author))
+                {
+                    <span class="flex items-center gap-1">
+                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
+                        @Model.Author
+                    </span>
+                }
+                @if (Model.PublishDate > DateTime.MinValue)
+                {
+                    <span class="flex items-center gap-1">
+                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
+                        @Model.PublishDate.ToString("MMMM dd, yyyy")
+                    </span>
+                }
+                <a href="/" class="ml-auto text-blue-600 hover:text-blue-800 underline">← Back to Blog</a>
+            </div>
+        </header>
+
+        @if (Model.BodyText != null)
+        {
+            <div class="prose prose-lg max-w-none mb-10">
+                @Model.BodyText
+            </div>
+        }
+
+        @if (Model.Blocks != null)
+        {
+            @await Html.PartialAsync("blockgrid/default", Model.Blocks)
+        }
+    </article>
+
+    <footer class="border-t border-gray-200 py-8 text-center text-sm text-gray-500">
+        <div class="max-w-4xl mx-auto px-4">
+            <a href="/" class="text-blue-600 hover:text-blue-800 underline">← Back to Blog</a>
+        </div>
+    </footer>
+</body>
+</html>