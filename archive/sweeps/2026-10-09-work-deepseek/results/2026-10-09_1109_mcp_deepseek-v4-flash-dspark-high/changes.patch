diff --git a/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/blogPostListBlock.cshtml b/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/blogPostListBlock.cshtml
new file mode 100644
index 0000000..1d54f6c
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/blogPostListBlock.cshtml
@@ -0,0 +1,81 @@
+@using Umbraco.Cms.Core.Models.Blocks
+@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Cms.Core.Models
+@using Umbraco.Cms.Web.Common.PublishedModels
+@using Umbraco.Extensions
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
+@{
+    var block = Model.Content as BlogPostListBlock;
+    if (block == null) { return; }
+
+    var maxItems = block.MaxItems > 0 ? block.MaxItems : 10;
+
+    // Find blog posts from all content at root
+    var allContent = Umbraco.ContentAtRoot();
+    var posts = new List<BlogPost>();
+    foreach (var root in allContent)
+    {
+        foreach (var child in root.Children())
+        {
+            var blogPost = child as BlogPost;
+            if (blogPost != null && blogPost.IsVisible())
+            {
+                posts.Add(blogPost);
+            }
+        }
+    }
+    posts = posts.OrderByDescending(p => p.PublishDate).Take(maxItems).ToList();
+}
+
+@if (!string.IsNullOrEmpty(block.Heading))
+{
+    <h2 class="text-3xl font-bold text-gray-900 mb-8">@block.Heading</h2>
+}
+
+@if (posts.Count == 0)
+{
+    <div class="text-center py-12 text-gray-500">
+        <p>No blog posts yet. Check back soon!</p>
+    </div>
+}
+else
+{
+    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
+        @foreach (var post in posts)
+        {
+            <a href="@post.Url()" class="group block bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
+                @if (post.FeaturedImage != null)
+                {
+                    var thumbUrl = post.FeaturedImage.GetCropUrl(600, 400);
+                    if (thumbUrl != null)
+                    {
+                        <img src="@thumbUrl" alt="@post.PageTitle" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
+                    }
+                }
+                else
+                {
+                    <div class="w-full h-48 bg-gradient-to-br from-blue-500 to-purple-600"></div>
+                }
+                <div class="p-5">
+                    <h3 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
+                        @(post.PageTitle ?? post.Name)
+                    </h3>
+                    @if (!string.IsNullOrEmpty(post.Excerpt))
+                    {
+                        <p class="text-gray-600 text-sm line-clamp-3">@post.Excerpt</p>
+                    }
+                    <div class="flex items-center gap-3 mt-4 text-xs text-gray-400">
+                        @if (!string.IsNullOrEmpty(post.Author))
+                        {
+                            <span>@post.Author</span>
+                        }
+                        @if (post.PublishDate > DateTime.MinValue)
+                        {
+                            <span>@post.PublishDate.ToString("MMM dd, yyyy")</span>
+                        }
+                    </div>
+                </div>
+            </a>
+        }
+    </div>
+}
diff --git a/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/heroBlock.cshtml b/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/heroBlock.cshtml
new file mode 100644
index 0000000..c1080eb
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/heroBlock.cshtml
@@ -0,0 +1,33 @@
+@using Umbraco.Cms.Core.Models.Blocks
+@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Cms.Core.Models
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
+@{
+    var block = Model.Content as HeroBlock;
+    if (block == null) { return; }
+
+    var bgStyle = "";
+    if (block.BackgroundImage != null)
+    {
+        var bgUrl = block.BackgroundImage.GetCropUrl(2000, 800);
+        if (bgUrl != null)
+        {
+            bgStyle = $"background-image: url('{bgUrl}');";
+        }
+    }
+}
+
+<div class="relative overflow-hidden rounded-xl bg-cover bg-center bg-gray-800 text-white py-20 px-8 md:px-16 mb-8"
+     style="@bgStyle">
+    <div class="absolute inset-0 bg-black/50"></div>
+    <div class="relative z-10 max-w-3xl mx-auto text-center">
+        @if (!string.IsNullOrEmpty(block.Heading))
+        {
+            <h1 class="text-4xl md:text-5xl font-bold mb-4">@block.Heading</h1>
+        }
+        @if (!string.IsNullOrEmpty(block.Text))
+        {
+            <p class="text-lg md:text-xl text-gray-200">@block.Text</p>
+        }
+    </div>
+</div>
