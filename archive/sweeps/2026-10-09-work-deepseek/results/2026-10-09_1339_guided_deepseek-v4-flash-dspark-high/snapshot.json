      "id": "1efc54a6-f0c2-49e6-a0c2-da6d52b929e4",
      "name": "Blog",
      "path": "WWW / Blog",
      "docTypeId": "ee7703a2-f605-4ba7-804b-6ffb9286c2d4",
      "templateId": "50af03bb-9d63-41f7-a834-68f849d08f36",
