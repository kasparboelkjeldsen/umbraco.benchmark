      ],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "pageTitle",
          "value": "Why MCP is Awesome"
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "443e9973-96d0-46ad-bc11-b36c3ec92b35",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "8a227b85-4d4d-4205-b645-e7a1f4da3496",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "c9ed7cd9-779e-4c46-bf22-ef7c930831d1",
                "key": "443e9973-96d0-46ad-bc11-b36c3ec92b35",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "Why MCP is Awesome"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": "This blog site was built entirely through Umbraco's MCP servers — a demonstration of what's possible when AI conversations can design, model, and publish content directly into a CMS."
                  }
                ]
              },
              {
                "contentTypeKey": "9a051694-c6f1-4e3e-8a56-e048de081767",
                "key": "8a227b85-4d4d-4205-b645-e7a1f4da3496",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "content",
                    "value": {
                      "markup": "<h2>Built with MCP</h2><p>Every piece of this site was created through the Umbraco MCP servers — from the document types and data types to the templates, media, and content blocks you see here.</p><p>The Model Context Protocol made it possible for an AI assistant to navigate Umbraco's backoffice programmatically, creating a fully functional blog with zero manual clicks.</p><h2>What was created</h2><ul><li><strong>Content modelling</strong> — Element types (heroBlock, richTextBlock), page types (blogFrontPage, blogPost), and a Block Grid data type</li><li><strong>Media</strong> — 10 Unsplash photos imported directly into the media library</li><li><strong>Pages</strong> — A front page with two published blog posts, each with hero and rich text blocks</li><li><strong>Templates &amp; views</strong> — Razor views following AGENTS.md conventions, with ViewComponent-per-block rendering</li><li><strong>Frontend</strong> — Tailwind CSS via Vite build pipeline</li></ul><p>All of this without opening a browser. That's the power of MCP.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "443e9973-96d0-46ad-bc11-b36c3ec92b35",
                "culture": null,
                "segment": null
              },
