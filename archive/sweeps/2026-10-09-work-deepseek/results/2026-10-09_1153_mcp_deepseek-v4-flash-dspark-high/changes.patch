@@ -0,0 +1,23 @@
+@using Umbraco.Extensions
+@model Umbraco.Bench.Umbraco.Models.HeroBlock
+
+@{
+    var bgImage = Model.BackgroundImage;
+}
+
+<div class="hero-block" style="position: relative; min-height: 400px; display: flex; align-items: center; justify-content: center; color: #fff; text-align: center; overflow: hidden; border-radius: 8px;">
+    @if (bgImage != null)
+    {
+        <div style="position: absolute; inset: 0; z-index: 0;">
+            <img src="@bgImage.GetCropUrl(1920, 600)" alt="@Model.Heading" style="width: 100%; height: 100%; object-fit: cover;" />
+            <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.5);"></div>
+        </div>
+    }
+    <div style="position: relative; z-index: 1; padding: 60px 30px; max-width: 800px;">
+        <h1 style="font-size: 2.5rem; margin: 0 0 16px; font-weight: 700;">@Model.Heading</h1>
+        @if (!string.IsNullOrWhiteSpace(Model.Subheading))
+        {
+            <p style="font-size: 1.2rem; margin: 0; opacity: 0.9;">@Model.Subheading</p>
+        }
+    </div>
+</div>
