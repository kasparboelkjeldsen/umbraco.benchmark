diff --git a/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml b/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml
new file mode 100644
index 0000000..807868c
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml
@@ -0,0 +1,64 @@
+@using Umbraco.Extensions
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Bench.Umbraco.Models.BlogFrontPage>
+@{
+    Layout = null;
+    var blogPosts = Model.Children<Umbraco.Bench.Umbraco.Models.BlogPost>();
+}
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@Model.Title</title>
+    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
+</head>
+<body style="background: #f8fafc; color: #1a202c;">
+    <div class="container py-4">
+        @if (!string.IsNullOrWhiteSpace(Model.Title))
+        {
+            <h1 class="mb-2">@Model.Title</h1>
+        }
+        @if (!string.IsNullOrWhiteSpace(Model.Description))
+        {
+            <p class="lead mb-4 text-muted">@Model.Description</p>
+        }
+
+        @if (Model.Blocks?.Any() == true)
+        {
+            @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+        }
+
+        @if (blogPosts?.Any() == true)
+        {
+            <h2 class="mt-5 mb-3">Latest Posts</h2>
+            <div class="row">
+                @foreach (var post in blogPosts)
+                {
+                    <div class="col-md-6 mb-4">
+                        <div class="card h-100 shadow-sm">
+                            @if (post.FeaturedImage != null)
+                            {
+                                <img src="@post.FeaturedImage.GetCropUrl(600, 300)" class="card-img-top" alt="@post.Title" style="object-fit: cover; height: 200px;" />
+                            }
+                            <div class="card-body">
+                                <h5 class="card-title">@post.Title</h5>
+                                @if (!string.IsNullOrWhiteSpace(post.Excerpt))
+                                {
+                                    <p class="card-text text-muted">@post.Excerpt</p>
+                                }
+                                <a href="@post.Url()" class="btn btn-primary">Read More</a>
+                            </div>
+                            @if (!string.IsNullOrWhiteSpace(post.AuthorName))
+                            {
+                                <div class="card-footer text-muted">
+                                    <small>By @post.AuthorName</small>
+                                </div>
+                            }
+                        </div>
+                    </div>
+                }
+            </div>
+        }
+    </div>
+</body>
+</html>
diff --git a/Umbraco.Bench.Umbraco/Views/blogPost.cshtml b/Umbraco.Bench.Umbraco/Views/blogPost.cshtml
new file mode 100644
index 0000000..164691d
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogPost.cshtml
@@ -0,0 +1,50 @@
+@using Umbraco.Extensions
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Bench.Umbraco.Models.BlogPost>
+@{
+    Layout = null;
+}
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@Model.Title</title>
+    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
+</head>
+<body style="background: #f8fafc; color: #1a202c;">
+    <div class="container py-4">
+        @{
+            var parentPage = Model.Parent<Umbraco.Bench.Umbraco.Models.BlogFrontPage>();
+            var parentUrl = parentPage?.Url();
+        }
+        @if (!string.IsNullOrWhiteSpace(parentUrl))
+        {
+            <a href="@parentUrl" class="btn btn-outline-secondary mb-4">&larr; Back to Blog</a>
+        }
+
+        <article>
+            @if (Model.FeaturedImage != null)
+            {
+                <img src="@Model.FeaturedImage.GetCropUrl(1200, 400)" alt="@Model.Title" style="width: 100%; height: 300px; object-fit: cover; border-radius: 8px; margin-bottom: 24px;" />
+            }
+
+            <h1>@Model.Title</h1>
+
+            @if (!string.IsNullOrWhiteSpace(Model.AuthorName))
+            {
+                <p class="text-muted mb-4">By @Model.AuthorName</p>
+            }
+
+            @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
+            {
+                <p class="lead mb-4">@Model.Excerpt</p>
+            }
+
+            @if (Model.Content?.Any() == true)
+            {
+                @await Html.GetBlockGridHtmlAsync(Model, "content")
+            }
+        </article>
+    </div>
+</body>
+</html>
