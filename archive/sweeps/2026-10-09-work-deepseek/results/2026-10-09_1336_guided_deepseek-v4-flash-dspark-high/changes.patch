+﻿@using Umbraco.Cms.Web.Common.PublishedModels
+@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
+@{
+    Layout = "Layout.cshtml";
+}
+<main class="max-w-4xl mx-auto px-4 py-12">
+    <article>
+        <h1 class="text-4xl font-bold mb-6">@Model.Name</h1>
+        @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+    </article>
+</main>
diff --git a/Umbraco.Bench.Umbraco/Views/layout.cshtml b/Umbraco.Bench.Umbraco/Views/layout.cshtml
new file mode 100644
index 0000000..0c61720
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/layout.cshtml
@@ -0,0 +1,24 @@
+﻿<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>Umbraco.Bench</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</head>
+<body class="bg-gray-50 text-gray-900 antialiased">
+    <header class="bg-white shadow-sm border-b">
+        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
+            <a href="/" class="text-2xl font-bold text-blue-600">Umbraco.Bench</a>
+            <nav>
+                <a href="/" class="text-gray-600 hover:text-blue-600 transition-colors">Home</a>
+            </nav>
+        </div>
+    </header>
+    @RenderBody()
+    <footer class="bg-white border-t mt-16 py-8 text-center text-gray-500 text-sm">
+        <p>@DateTime.Now.Year Umbraco.Bench. Built with Umbraco and MCP.</p>
+    </footer>
+</body>
+</html>