    {
      "id": "2d5c9fd8-04d4-47e5-ae6c-d701b6dbc034",
      "name": "Why MCP is awesome for content teams",
      "path": "WWW / Blog / Why MCP is awesome for content teams",
      "docTypeId": "bfcf3aca-f501-4ecc-bcae-1c53eabe01eb",
      "templateId": "d51181c6-fd50-417f-86bb-32b8a255dfee",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is awesome for content teams"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-05 00:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "MCP lets an editor ask for a change in plain language, and lets the tool do exactly that and nothing more. Here is what that looks like on a real site."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
