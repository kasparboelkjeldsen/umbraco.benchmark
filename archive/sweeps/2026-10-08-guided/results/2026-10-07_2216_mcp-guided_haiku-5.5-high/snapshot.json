                  "areas": [],
                  "contentKey": "a7eb3ec4-f527-4d37-903f-bf6c5521f93f",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "ab43a4e2-6274-48e1-a7ed-078aa329b85b",
                "key": "da7e77b3-625d-4749-bdab-95e02535a226",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Editors rarely want a new admin screen. They want to say what they need and see it done. MCP makes that possible by giving an assistant a well-defined set of actions on the site.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "4d1d0345-3e9e-4470-813a-2090c0c502f9",
                "key": "b740aff7-ac88-42d4-b6b7-bd6388bb2412",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "3f7a1c2e-8b4d-4e6f-9a10-2c5d7e9b1f11",
                        "mediaKey": "e5f752ee-767f-4973-91a4-bcafe236de99",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Photo by Christopher Gower on Unsplash"
                  }
                ]
              },
              {
                "contentTypeKey": "f39d133a-7afb-4d9c-80fa-d286211ee75b",
                "key": "345daaa7-0630-4616-bc1c-3e122400312d",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "What editors get"
                  },
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": "A plain-language request, a clear result, and a confirmation before anything is published."
                  }
                ]
              },
              {
                "contentTypeKey": "ab43a4e2-6274-48e1-a7ed-078aa329b85b",
                "key": "a7eb3ec4-f527-4d37-903f-bf6c5521f93f",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
