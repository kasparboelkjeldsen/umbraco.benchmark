+@inherits UmbracoViewPage<BlogPost>
+@{
+    Layout = "siteLayout.cshtml";
+    var parent = Model.Ancestor<BlogFrontPage>();
+}
+<article>
+    <div class="max-w-3xl mx-auto px-6 pt-10 pb-4">
+        @if (parent is not null)
+        {
+            <p class="text-sm font-medium text-sky-600"><a href="@parent.Url()">@parent.Name()</a></p>
+        }
+        <h1 class="text-4xl font-bold tracking-tight mt-2">@Model.Name()</h1>
+        @if (Model.Excerpt is { } excerpt)
+        {
+            <p class="text-lg text-slate-600 mt-3">@excerpt</p>
+        }
+    </div>
+    <div class="max-w-3xl mx-auto px-6 pb-16">
+        @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+    </div>
+</article>
