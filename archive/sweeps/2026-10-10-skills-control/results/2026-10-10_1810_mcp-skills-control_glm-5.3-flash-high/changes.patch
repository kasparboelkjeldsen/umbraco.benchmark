+@inherits UmbracoViewPage
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@Model.Name() — MCP Matters</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
+</head>
+<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased">
+    <header class="bg-white border-b border-slate-200">
+        <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
+            <a href="/" class="text-lg font-bold tracking-tight">MCP Matters</a>
+            <nav class="flex items-center gap-6 text-sm font-medium text-slate-600">
+                <a href="/" class="hover:text-slate-900">Home</a>
+            </nav>
+        </div>
+    </header>
+    <main class="flex-1">
+        @RenderBody()
+    </main>
+    <footer class="bg-slate-900 text-slate-400">
+        <div class="max-w-6xl mx-auto px-6 py-8 text-sm flex flex-wrap items-center justify-between gap-2">
+            <p>MCP Matters — a tiny blog built to demo the Umbraco MCP servers.</p>
+            <p>Umbraco 18 + Claude Code, October 2026</p>
+        </div>
+    </footer>
+</body>
+</html>
