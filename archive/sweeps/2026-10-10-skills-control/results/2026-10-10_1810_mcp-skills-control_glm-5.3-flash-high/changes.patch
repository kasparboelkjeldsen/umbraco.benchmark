@@ -0,0 +1,37 @@
+@model Umbraco.Bench.Umbraco.Models.Blocks.PostListModel
+@{
+    var style = Model.Presentation.BackgroundColor is { } bg ? $"background-color:{bg};" : "";
+    var pad = Model.Presentation.Spacing is { } s ? $"padding:{s}px;" : "";
+}
+<div class="max-w-6xl mx-auto px-6" style="@style@pad">
+    @if (Model.Presentation.AnchorId is { } anchor)
+    {
+        <span id="@anchor"></span>
+    }
+    @if (Model.Posts.Count == 0)
+    {
+        if (!string.IsNullOrWhiteSpace(Model.Heading))
+        {
+            <h2 class="text-2xl md:text-3xl font-bold tracking-tight py-6">@Model.Heading</h2>
+        }
+        <p class="text-slate-500 py-4">No posts yet — check back soon.</p>
+        return;
+    }
+    <div class="grid gap-6 py-6 sm:grid-cols-2">
+        @foreach (var post in Model.Posts)
+        {
+            <a href="@post.Url" class="group block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition">
+                @if (!string.IsNullOrWhiteSpace(Model.Heading))
+                {
+                    <p class="text-xs font-semibold uppercase tracking-wider text-sky-600">@Model.Heading</p>
+                }
+                <h3 class="mt-1 text-xl font-bold tracking-tight text-slate-900 group-hover:text-sky-700 transition">@post.Title</h3>
+                @if (post.Excerpt is { } excerpt)
+                {
+                    <p class="mt-2 text-sm text-slate-600 line-clamp-3">@excerpt</p>
+                }
+                <p class="mt-4 text-sm font-semibold text-sky-600">Read post →</p>
+            </a>
+        }
+    </div>
+</div>
