+@inherits UmbracoViewPage<BlockGridItem<PostListBlock>>
+@using Umbraco.Cms.Core.Models.Blocks
+@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Bench.Umbraco.Models.Blocks
+@{
+    var posts = Umbraco.AssignedContentItem?
+        .AncestorOrSelf<BlogFrontPage>()
+        ?.Children<BlogPost>()
+        .OrderByDescending(p => p.CreateDate)
+        .ToList() ?? [];
+    var listModel = new PostListModel(
+        Model.Content.Heading,
+        posts.Select(p => new PostListItem(p.Url(), p.Name(), p.Excerpt)).ToList(),
+        BlockPresentation.From(Model.Settings as BlockSettings));
+}
+@await Component.InvokeAsync("PostList", new { model = listModel })
