new file mode 100644
index 0000000..3406bfa
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Models/Blocks/BlockPresentation.cs
@@ -0,0 +1,12 @@
+namespace Umbraco.Bench.Umbraco.Models.Blocks;
+
+/// <summary>
+/// Presentation settings shared by every block (background, spacing, anchor).
+/// </summary>
+public sealed record BlockPresentation(string? BackgroundColor, int? Spacing, string? AnchorId)
+{
+    public static BlockPresentation From(BlockSettings? settings) => new(
+        settings?.BackgroundColor?.Color,
+        settings?.Spacing is > 0 ? settings.Spacing : null,
+        string.IsNullOrWhiteSpace(settings?.AnchorId) ? null : settings.AnchorId);
+}
