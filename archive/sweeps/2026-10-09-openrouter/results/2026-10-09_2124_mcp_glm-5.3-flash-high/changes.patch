diff --git a/Umbraco.Bench.Umbraco/Views/Shared/Components/Hero/Default.cshtml b/Umbraco.Bench.Umbraco/Views/Shared/Components/Hero/Default.cshtml
new file mode 100644
index 0000000..30787d5
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Shared/Components/Hero/Default.cshtml
@@ -0,0 +1,15 @@
+@using Umbraco.Bench.Umbraco.Models.Blocks
+@model HeroModel
+<section class="relative overflow-hidden bg-slate-900 text-white">
+    @if (!string.IsNullOrEmpty(Model.ImageUrl))
+    {
+        <img src="@Model.ImageUrl" class="absolute inset-0 h-full w-full object-cover opacity-40" alt="" />
+    }
+    <div class="relative mx-auto max-w-4xl px-6 py-20">
+        <h1 class="text-4xl font-bold tracking-tight">@Model.Heading</h1>
+        @if (!string.IsNullOrEmpty(Model.Text))
+        {
+            <p class="mt-4 max-w-2xl text-lg text-slate-300">@Model.Text</p>
+        }
+    </div>
+</section>
diff --git a/Umbraco.Bench.Umbraco/Views/Shared/Components/Image/Default.cshtml b/Umbraco.Bench.Umbraco/Views/Shared/Components/Image/Default.cshtml
