                  "areas": [],
                  "contentKey": "a493df0a-aaa9-4f86-b1ef-c5346d2ac4f9",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "a6020ea9-c321-4985-b3f5-a16410cb5493",
                "key": "c5e2e484-890e-4311-865c-f295c9bdc028",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "heading",
                    "value": "MCP Made This Blog Possible"
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "subheading",
                    "value": "Schema, content, media — an agent built this whole site by talking to Umbraco over MCP."
                  },
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "backgroundImage",
                    "value": [
                      {
                        "key": "19542dc7-22e5-4f88-97bb-5f70eeb36229",
                        "mediaKey": "51290c54-01d9-4578-b2b3-66e5823700e1",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "06389e85-f308-467f-9f48-2ae1b3fe07dd",
                "key": "3238ecdb-1259-436b-84b9-6fbd335ab494",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<p>This blog — the document types, the block element types, the templates, these very words, the photos — was created end to end by an agent talking to Umbraco's management API over MCP. Not one click in the backoffice.</p><h2>Schema first, content second</h2><p>The agent modeled the schema before writing a word: a <strong>Blog Front Page</strong> and a <strong>Blog Post</strong> document type, plus three block element types — hero, rich text, image — each filed into the right folder by the project's own rules. Only then did it create content, because content needs a schema to land in.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "40471ceb-3ed3-4c2c-ac14-da1c604ed2ed",
                "key": "44594bb2-dcae-4adb-aba0-cacebbf8f5cd",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "7ec1b89f-a263-41c7-9d6d-6cfb8fc0604a",
                        "mediaKey": "815039bc-31ff-452d-ac5b-8c81dedc83a6",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Under the hood of every good integration. Photo by Alexandre Debiève on Unsplash."
                  }
                ]
              },
              {
                "contentTypeKey": "06389e85-f308-467f-9f48-2ae1b3fe07dd",
                "key": "a493df0a-aaa9-4f86-b1ef-c5346d2ac4f9",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "body",
                    "value": {
                      "markup": "<h2>Blocks all the way down</h2><p>Every page body is a block grid. The hero, the paragraphs, the photos — all blocks, rendered by Umbraco's own pipeline, each block a small view component behind a thin adapter partial. No custom renderers, no wrapper models — just Umbraco's conventions.</p><p>Then the pipeline: stop the site, rebuild so the generated models exist, write the Razor, restart. Three steps, one flow, and a blog that renders. That is MCP being awesome — the agent did the plumbing so the site could simply exist.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "c5e2e484-890e-4311-865c-f295c9bdc028",
