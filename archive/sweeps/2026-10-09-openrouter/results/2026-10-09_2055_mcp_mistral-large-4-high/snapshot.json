    {
      "id": "c4c15f6d-0678-435f-a0b7-b99b5512abcf",
      "name": "MCP Made This Blog Possible",
      "path": "WWW / The MCP Blog / MCP Made This Blog Possible",
      "docTypeId": "ce9277d4-0f4b-44cb-b319-8338454cdd66",
      "templateId": "abfcaba9-7576-40b4-a775-06f187f6c033",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "summary",
          "value": "This entire site — schema, blocks, posts, images — was built by an agent talking to Umbraco over MCP. Not one backoffice click."
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-09 00:00:00"
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "blocks",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": null,
                  "rowSpan": null,
                  "areas": [],
                  "contentKey": "c5e2e484-890e-4311-865c-f295c9bdc028",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": null,
                  "rowSpan": null,
