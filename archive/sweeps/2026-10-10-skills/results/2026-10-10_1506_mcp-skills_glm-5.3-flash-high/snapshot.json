                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Welcome to a tiny blog built entirely over the Umbraco MCP servers — every document type, block, image and word on this site was modeled, created and published through tool calls.</p>",
