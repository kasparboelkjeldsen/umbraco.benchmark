                "contentKey": "6ed45e77-fafa-4cb8-abca-4e635000720f",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/why-mcp-is-awesome-one-plug-for-every-tool/"
