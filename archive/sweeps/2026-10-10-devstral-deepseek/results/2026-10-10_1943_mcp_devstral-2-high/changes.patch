diff --git a/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/blogPostCardBlock.cshtml b/Umbraco.Bench.Umbraco/Views/Partials/blockgrid/Components/blogPostCardBlock.cshtml
