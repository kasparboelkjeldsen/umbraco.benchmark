@@ -0,0 +1,16 @@
+@using Umbraco.Cms.Core.Models.Blocks
+@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Cms.Core.Models.PublishedContent
+@using Umbraco.Cms.Core.Models
+@inherits UmbracoViewPage<BlockGridItem<BlogPostCardBlock>>
+@{
+    var blogPost = Model.Content.BlogPost;
+    var model = new Umbraco.Bench.Umbraco.ViewComponents.BlogPostCardModel
+    {
+        Title = blogPost?.Name ?? "",
+        Url = blogPost?.Url(),
+        Excerpt = blogPost?.Value<string>("excerpt") ?? "",
+        ImageUrl = blogPost?.Value<MediaWithCrops>("featuredImage")?.GetCropUrl(width: 400, height: 250)
+    };
+}
+@await Component.InvokeAsync("BlogPostCard", new { model })
