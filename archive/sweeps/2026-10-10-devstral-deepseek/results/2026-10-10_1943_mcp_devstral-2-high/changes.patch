diff --git a/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml b/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml
new file mode 100644
index 0000000..a8d6640
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/blogFrontPage.cshtml
@@ -0,0 +1,78 @@
+@using Umbraco.Bench.Umbraco.Models
+@inherits UmbracoViewPage<BlogFrontPage>
+@{
+    Layout = null;
+    var blogPosts = Model.Children<BlogPost>().ToList();
+}
+
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>@Model.Title - MCP Blog</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body class="bg-gray-50">
+    <header class="bg-white shadow-sm">
+        <div class="container mx-auto px-4 py-6">
+            <h1 class="text-3xl font-bold text-gray-900">
+                <a href="/">@Model.Title</a>
+            </h1>
+            <nav class="mt-4">
+                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
+            </nav>
+        </div>
+    </header>
+
+    <main class="container mx-auto px-4 py-8">
+        @if (Model.Blocks != null && Model.Blocks.Any())
+        {
+            @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+        }
+
+        <section class="mt-12">
+            <h2 class="text-2xl font-bold text-gray-900 mb-6">Latest Posts</h2>
+
+            @if (blogPosts.Any())
+            {
+                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
+                    @foreach (var post in blogPosts)
+                    {
+                        <article class="bg-white rounded-lg shadow-md overflow-hidden">
+                            @if (post.FeaturedImage != null)
+                            {
+                                <img src="@post.FeaturedImage.GetCropUrl(width: 400, height: 250)"
+                                     alt="@post.Title"
+                                     class="w-full h-48 object-cover">
+                            }
+                            <div class="p-6">
+                                <h3 class="text-xl font-bold mb-2">
+                                    <a href="@post.Url()" class="text-blue-600 hover:text-blue-800">@post.Title</a>
+                                </h3>
+                                <p class="text-gray-600 text-sm mb-2">
+                                    Published: @post.PublishDate.ToString("MMMM dd, yyyy")
+                                </p>
+                                <p class="text-gray-600 mb-4">@post.Excerpt</p>
+                                <a href="@post.Url()" class="text-blue-600 hover:text-blue-800 font-medium">
+                                    Read more &raquo;
+                                </a>
+                            </div>
+                        </article>
+                    }
+                </div>
+            }
+            else
+            {
+                <p class="text-gray-500">No blog posts yet.</p>
+            }
+        </section>
+    </main>
+
+    <footer class="bg-gray-900 text-white py-8 mt-12">
+        <div class="container mx-auto px-4 text-center">
+            <p>&copy; @DateTime.Now.Year - MCP Blog Demo</p>
+        </div>
+    </footer>
+</body>
+</html>
