+@model Umbraco.Bench.Umbraco.ViewComponents.HeroModel
+
+<section class="relative bg-gray-900 text-white py-20">
+    @if (Model.ImageUrl != null)
+    {
+        <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('@Model.ImageUrl');"></div>
+        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 to-transparent"></div>
+    }
+    <div class="relative container mx-auto px-4 text-center">
+        <h1 class="text-5xl font-bold mb-4">@Model.Heading</h1>
+        @if (!string.IsNullOrEmpty(Model.Subheading))
+        {
+            <p class="text-xl text-gray-300">@Model.Subheading</p>
+        }
+    </div>
+</section>
