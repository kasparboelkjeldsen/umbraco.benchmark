@@ -0,0 +1,65 @@
+@using Umbraco.Bench.Umbraco.Models
+@inherits UmbracoViewPage<BlogPost>
+@{
+    Layout = null;
+}
+
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>@Model.Title - MCP Blog</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+</head>
+<body class="bg-gray-50">
+    <header class="bg-white shadow-sm">
+        <div class="container mx-auto px-4 py-6">
+            <h1 class="text-3xl font-bold text-gray-900">
+                <a href="/">MCP Blog</a>
+            </h1>
+            <nav class="mt-4">
+                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
+            </nav>
+        </div>
+    </header>
+
+    <main class="container mx-auto px-4 py-8">
+        <article class="max-w-4xl mx-auto bg-white rounded-lg shadow-md p-8">
+            <header class="mb-8">
+                <h1 class="text-4xl font-bold text-gray-900 mb-4">@Model.Title</h1>
+                <div class="flex items-center text-gray-500 text-sm">
+                    <span>Published: @Model.PublishDate.ToString("MMMM dd, yyyy")</span>
+                </div>
+            </header>
+
+            @if (Model.FeaturedImage != null)
+            {
+                <img src="@Model.FeaturedImage.GetCropUrl(width: 1200, height: 400)"
+                     alt="@Model.Title"
+                     class="w-full rounded-lg mb-8">
+            }
+
+            <div class="prose max-w-none">
+                @if (Model.Content != null)
+                {
+                    @Html.Raw(Model.Content)
+                }
+            </div>
+
+            @if (Model.Blocks != null && Model.Blocks.Any())
+            {
+                <div class="mt-12">
+                    @await Html.GetBlockGridHtmlAsync(Model, "blocks")
+                </div>
+            }
+        </article>
+    </main>
+
+    <footer class="bg-gray-900 text-white py-8 mt-12">
+        <div class="container mx-auto px-4 text-center">
+            <p>&copy; @DateTime.Now.Year - MCP Blog Demo</p>
+        </div>
+    </footer>
+</body>
+</html>