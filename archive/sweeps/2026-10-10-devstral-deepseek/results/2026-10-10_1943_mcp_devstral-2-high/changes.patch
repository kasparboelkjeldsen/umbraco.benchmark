+    @if (Model.ImageUrl != null)
+    {
+        <img src="@Model.ImageUrl" alt="@Model.Title" class="w-full h-48 object-cover">
+    }
+    <div class="p-6">
+        <h2 class="text-2xl font-bold mb-2">
+            <a href="@Model.Url" class="text-blue-600 hover:text-blue-800">@Model.Title</a>
+        </h2>
+        <p class="text-gray-600 mb-4">@Model.Excerpt</p>
+        <a href="@Model.Url" class="text-blue-600 hover:text-blue-800 font-medium">Read more &raquo;</a>
+    </div>
+</article>
