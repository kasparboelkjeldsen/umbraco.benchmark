      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "MCP and Umbraco: A Perfect Match"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-10 10:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "Umbraco CMS and MCP servers work together beautifully to create powerful content management workflows."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
