            },
            "contentData": [
              {
                "contentTypeKey": "44466755-13ac-4514-b1a7-276f60ed513c",
                "key": "042207f1-eb25-4afb-8ca3-d9eb9e98e4a1",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Umbraco is a powerful and flexible CMS, and MCP servers make it even more powerful. Together, they create a seamless experience for content editors and developers alike.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "50a3499b-80cd-46a5-b762-a7bc59b27af0",
                "key": "05e21a28-2e10-4ce4-be8e-5e415c667081",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "d4e5f6a7-b8c9-49d0-a0f1-b2c3d4e5f6a7",
                        "mediaKey": "811f1152-747b-4cc3-8c6f-1ea64a79867b",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Network connections - representing the MCP ecosystem"
                  }
                ]
              },
              {
                "contentTypeKey": "44466755-13ac-4514-b1a7-276f60ed513c",
                "key": "d58ea3d0-c3a4-47d5-a4d3-8231057c63c8",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>With the Umbraco MCP server configured, you can manage your entire content structure through Claude Code. Create pages, upload media, organize document types - all through natural language commands.</p><p>This integration means you spend less time clicking through admin interfaces and more time building great content experiences.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "94b04b8a-0cd7-43c2-b3f7-50ac7360236c",
                "key": "8b613a11-600c-473e-aa6b-351801ae5812",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "The combination of Umbraco's flexibility and MCP's integration capabilities is a game-changer for content management."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "Tech Enthusiast"
                  }
                ]
              }
            ],
