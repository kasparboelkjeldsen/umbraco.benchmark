@@ -0,0 +1,13 @@
+@using Umbraco.Bench.Umbraco.Components
+@model ImageModel
+
+<figure class="my-8">
+    @if (!string.IsNullOrEmpty(Model.ImageUrl))
+    {
+        <img src="@Model.ImageUrl" alt="@Model.Caption" class="w-full h-auto rounded-lg shadow-lg" />
+    }
+    @if (!string.IsNullOrEmpty(Model.Caption))
+    {
+        <figcaption class="text-center mt-2 text-gray-600">@Model.Caption</figcaption>
+    }
+</figure>
