@@ -0,0 +1,16 @@
+@using Umbraco.Bench.Umbraco.Models
+@using Umbraco.Cms.Web.Common.Views
+@using Umbraco.Cms.Core.Models.Blocks
+@using Umbraco.Cms.Core.Models.PublishedContent
+@using Umbraco.Bench.Umbraco.Components
+@inherits UmbracoViewPage<BlockGridItem<BlogPostCardBlock>>
+@{
+    var model = new BlogPostCardModel
+    {
+        Title = Model.Content.Title ?? "",
+        Excerpt = Model.Content.Excerpt ?? "",
+        ImageUrl = Model.Content.Image?.GetCropUrl(width: 400, height: 300),
+        LinkUrl = Model.Content.Link?.Url() ?? ""
+    };
+}
+@await Component.InvokeAsync("BlogPostCard", new { model })
