diff --git a/Umbraco.Bench.Umbraco/Views/_Layout.cshtml b/Umbraco.Bench.Umbraco/Views/_Layout.cshtml
new file mode 100644
index 0000000..b593e9e
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/_Layout.cshtml
@@ -0,0 +1,27 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@ViewData["Title"] - MCP Blog</title>
+    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />
+    <script src="https://cdn.tailwindcss.com"></script>
+</head>
+<body class="bg-gray-50">
+    <header class="bg-blue-600 text-white py-4">
+        <div class="container mx-auto px-4">
+            <h1 class="text-2xl font-bold"><a href="/" class="hover:text-blue-200">MCP Blog</a></h1>
+        </div>
+    </header>
+
+    <main>
+        @RenderBody()
+    </main>
+
+    <footer class="bg-gray-800 text-white py-8 mt-16">
+        <div class="container mx-auto px-4 text-center">
+            <p>Built with Umbraco and MCP</p>
+        </div>
+    </footer>
+</body>
+</html>
