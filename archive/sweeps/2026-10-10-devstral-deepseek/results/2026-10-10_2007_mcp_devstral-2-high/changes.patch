+++ b/Umbraco.Bench.Umbraco/Views/Shared/Components/Hero/Default.cshtml
@@ -0,0 +1,13 @@
+@using Umbraco.Bench.Umbraco.Components
+@model HeroModel
+
+<div class="relative bg-cover bg-center h-96 flex items-center justify-center text-white" style="background-image: url('@Model.ImageUrl');">
+    <div class="absolute inset-0 bg-black bg-opacity-50"></div>
+    <div class="relative z-10 text-center px-4">
+        <h1 class="text-4xl md:text-6xl font-bold mb-4">@Model.Heading</h1>
+        @if (!string.IsNullOrEmpty(Model.Subheading))
+        {
+            <p class="text-xl md:text-2xl">@Model.Subheading</p>
+        }
+    </div>
+</div>
diff --git a/Umbraco.Bench.Umbraco/Views/Shared/Components/Image/Default.cshtml b/Umbraco.Bench.Umbraco/Views/Shared/Components/Image/Default.cshtml
