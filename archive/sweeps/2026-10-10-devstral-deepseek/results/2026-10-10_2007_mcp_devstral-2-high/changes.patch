diff --git a/Umbraco.Bench.Umbraco/Views/Shared/Components/BlogPostCard/Default.cshtml b/Umbraco.Bench.Umbraco/Views/Shared/Components/BlogPostCard/Default.cshtml
new file mode 100644
index 0000000..315af0d
--- /dev/null
+++ b/Umbraco.Bench.Umbraco/Views/Shared/Components/BlogPostCard/Default.cshtml
@@ -0,0 +1,16 @@
+@using Umbraco.Bench.Umbraco.Components
+@model BlogPostCardModel
+
+<article class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
+    @if (!string.IsNullOrEmpty(Model.ImageUrl))
+    {
+        <img src="@Model.ImageUrl" alt="@Model.Title" class="w-full h-48 object-cover" />
+    }
+    <div class="p-6">
+        <h3 class="text-xl font-bold mb-2">
+            <a href="@Model.LinkUrl" class="hover:text-blue-600">@Model.Title</a>
+        </h3>
+        <p class="text-gray-700 mb-4">@Model.Excerpt</p>
+        <a href="@Model.LinkUrl" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">Read More</a>
+    </div>
+</article>
diff --git a/Umbraco.Bench.Umbraco/Views/Shared/Components/Hero/Default.cshtml b/Umbraco.Bench.Umbraco/Views/Shared/Components/Hero/Default.cshtml
