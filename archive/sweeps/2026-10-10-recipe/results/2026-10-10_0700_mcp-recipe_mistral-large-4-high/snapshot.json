              {
                "contentKey": "8d8c491f-fa9a-4066-9ddf-d561ac45b3d0",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/why-mcp-is-awesome-tools-that-actually-fit-the-job/"
