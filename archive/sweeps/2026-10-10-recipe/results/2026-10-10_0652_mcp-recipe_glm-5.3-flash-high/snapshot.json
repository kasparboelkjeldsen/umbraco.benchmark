        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "intro",
          "value": "Notes on the Model Context Protocol — why a standard way to connect agents to tools changed how we build."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
