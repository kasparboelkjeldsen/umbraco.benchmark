              {
                "contentKey": "df123119-82b2-419e-abd0-17796f278dbd",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/why-mcp-is-awesome/"
      ],
      "docType": "blogPost",
