    {
      "id": "1a0e0442-19d4-4e55-8bd6-5be1273bf7f5",
      "name": "Why MCP Is Awesome",
      "path": "WWW / Why MCP Is Awesome",
      "docTypeId": "818b44f0-7bd3-4631-8fe8-7b6ea3acc568",
      "templateId": "5d051736-cd19-471e-b3d7-9010003df5c6",
      "state": "Published",
      "domains": [
        {
          "domainName": "/",
          "isoCode": "en-US"
        }
      ],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP Is Awesome"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "intro",
          "value": "Model Context Protocol turns any tool, dataset or service into something an AI assistant can actually use. Here we write about why that matters, one post at a time."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "49957eb1-0334-4994-aa02-a4ffcd8cfaed",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "b331764d-c903-4f97-a18f-3fe5048b2aed",
                "key": "49957eb1-0334-4994-aa02-a4ffcd8cfaed",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>These posts were modeled, written and published entirely through the Umbraco MCP servers — schema, media, content, publishing. The site you are reading is the demo.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "49957eb1-0334-4994-aa02-a4ffcd8cfaed",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
