    {
      "id": "59d3a3fe-bd83-4607-8e0a-3fa137fd248f",
      "name": "Three reasons MCP is worth the fuss",
      "path": "WWW / Blog / Three reasons MCP is worth the fuss",
      "docTypeId": "d9d190bc-3a5a-419a-8fb7-36ac58614c44",
      "templateId": "c6d55402-230f-4cca-855f-d492ae289e95",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Three reasons MCP is worth the fuss"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-08 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "A shared protocol, portable tools and clear error messages go a long way. Here is why MCP earns its place in the stack."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "ee1bb4c7-802a-4c5b-a28b-7087c15f9b0c",
              "mediaKey": "74b7e918-9396-4f9f-9cda-2d036f96f9cb",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "a8c45258-0fe3-4899-9719-4b2f6ab4fcbe",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "49fd396d-ce6d-4af3-9f9c-46722596e5d6",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "f654dcb3-055e-45b3-b3c9-f66bcc2bcc89",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "fae31a9f-5268-48a8-821b-a27c733c0e28",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "d7912b9e-0a8f-428b-97e9-bfa6dec791d5",
                "key": "a8c45258-0fe3-4899-9719-4b2f6ab4fcbe",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Most integrations start as one-off scripts. MCP turns them into a shared contract: the assistant discovers the tools, reads their descriptions and calls them with structured arguments.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "f1edb8a6-b05e-48ba-9e03-61a770f2db40",
                "key": "49fd396d-ce6d-4af3-9f9c-46722596e5d6",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "8fdfb093-3632-4f15-b8f1-f44ac69a3eed",
                        "mediaKey": "93e8fdd3-2dba-4cf2-9ae8-88a9537c63f5",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Photo by Alexandre Debiève on Unsplash."
                  }
                ]
              },
              {
                "contentTypeKey": "d7912b9e-0a8f-428b-97e9-bfa6dec791d5",
                "key": "f654dcb3-055e-45b3-b3c9-f66bcc2bcc89",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>First, it is portable. The same server works in any client that speaks MCP, so the setup is written once and reused.</p><p>Second, it is safe by default. Tools ask for confirmation before anything is published or deleted, so a person stays in the loop for the moves that matter.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "d674e487-b311-4ebf-ac5f-72f3214381bc",
                "key": "fae31a9f-5268-48a8-821b-a27c733c0e28",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "A small, well-described tool beats a clever script every time."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "Umbraco.Bench build notes"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "a8c45258-0fe3-4899-9719-4b2f6ab4fcbe",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "49fd396d-ce6d-4af3-9f9c-46722596e5d6",
                "culture": null,
