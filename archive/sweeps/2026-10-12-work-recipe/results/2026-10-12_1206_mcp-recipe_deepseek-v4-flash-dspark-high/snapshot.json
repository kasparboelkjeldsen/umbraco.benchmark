    {
      "id": "9a94a9f1-de09-46cb-8bc5-3d65494fc8df",
      "name": "MCP: A New Protocol for AI Tool Integration",
      "path": "WWW / Blog / MCP: A New Protocol for AI Tool Integration",
      "docTypeId": "187f6d18-0bb8-4102-9cf7-b51ce72913d0",
      "templateId": "20d58c22-95af-4343-801e-910cc23d7a12",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "MCP: A New Protocol for AI Tool Integration"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-01 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "The Model Context Protocol (MCP) is an open standard that lets AI models discover and interact with tools through a simple, unified interface. Here's why that matters for the future of AI."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
              "mediaKey": "7ff5a7ae-4825-4f19-af4b-75d3611cd7e6",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "a6e89be5-e0f9-4f7e-a8f9-bba63bbedbab",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "0e805eb0-cdfc-418d-b81f-303845eca06a",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "e7b5b19b-cc8f-49f2-958d-ab503ff702f2",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "2fb1694f-5db8-45aa-b5be-92b3a1e1d0e1",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "02ba9171-8f53-4f46-be9f-584154d17d87",
                "key": "a6e89be5-e0f9-4f7e-a8f9-bba63bbedbab",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>The Model Context Protocol (MCP) is an open standard developed by Anthropic that provides a universal way for AI models to connect with external tools and data sources. Think of it as a USB-C port for AI — a standard interface that any AI assistant can use to interact with any compatible tool server.</p><p>Before MCP, every AI integration was bespoke. Developers had to write custom code for each tool connection, each API, each data source. MCP standardizes this into a protocol where AI models discover available tools through a simple handshake, then call them through a consistent interface.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "898d17aa-2e63-4b92-919f-3d953604d5e4",
                "key": "0e805eb0-cdfc-418d-b81f-303845eca06a",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "f7b6756e-ddfe-4d2b-9bbf-1abd851e4bc5",
                        "mediaKey": "a7b863b8-cdca-482e-899e-ebd49b3b7237",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "MCP connects AI models to tools through a standardized protocol"
                  }
                ]
              },
              {
                "contentTypeKey": "02ba9171-8f53-4f46-be9f-584154d17d87",
                "key": "e7b5b19b-cc8f-49f2-958d-ab503ff702f2",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>What makes MCP truly powerful is its simplicity. An MCP server is just a program that advertises tools, resources, and prompts. Tools are functions the model can call. Resources are data the model can read. Prompts are pre-written templates the model can use. All of this is discovered at runtime through a JSON-RPC interface over stdin or HTTP.</p><p>This architecture means developers can write an MCP server once and immediately make their tool available to every MCP-compatible AI assistant — whether that's Claude Code, a custom agent, or any future AI tool that adopts the standard.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "ffd99a4f-5747-4f3e-b059-332b2adbb18a",
                "key": "2fb1694f-5db8-45aa-b5be-92b3a1e1d0e1",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "MCP is the most important open protocol for AI since, well, ever. It's the missing link between AI models and the tools they need to be truly useful."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "— AI Developer Community, 2026"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "a6e89be5-e0f9-4f7e-a8f9-bba63bbedbab",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "0e805eb0-cdfc-418d-b81f-303845eca06a",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "e7b5b19b-cc8f-49f2-958d-ab503ff702f2",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "2fb1694f-5db8-45aa-b5be-92b3a1e1d0e1",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/mcp-a-new-protocol-for-ai-tool-integration/"
      ],
      "docType": "blogPost",
      "template": "blogPost"
