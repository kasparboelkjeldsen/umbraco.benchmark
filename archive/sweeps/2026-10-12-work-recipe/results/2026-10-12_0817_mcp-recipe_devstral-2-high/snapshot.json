            "contentData": [
              {
                "contentTypeKey": "8d2ad68b-931d-453f-9168-af03390dffde",
                "key": "5a709665-1d03-400b-b47f-90f575bafabc",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Welcome to our blog about MCP - the Model Context Protocol that enables AI agents to interact seamlessly with applications!</p><p>MCP provides a standardized way for AI assistants to discover, read, and manipulate data through well-defined interfaces.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
