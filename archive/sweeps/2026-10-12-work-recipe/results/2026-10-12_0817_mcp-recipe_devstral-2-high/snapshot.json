              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "0fceac7f-3743-493b-bede-74da7f03c9c4",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "4599de7a-f609-473a-857b-3a10626e4d08",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "12bcd3e7-9977-4ba8-80d4-0caac2337911",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "39def753-4648-4a54-ade5-bd1efb546e29",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "8d2ad68b-931d-453f-9168-af03390dffde",
                "key": "0fceac7f-3743-493b-bede-74da7f03c9c4",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>The Model Context Protocol (MCP) is a game-changer for AI application integration.</p><p>Traditionally, AI agents had to use custom APIs or complex integrations to interact with applications. MCP standardizes this interaction, making it easier for developers and AI agents alike.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "b17419f8-ccc7-4077-9dc5-135b0404fc87",
                "key": "4599de7a-f609-473a-857b-3a10626e4d08",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "b2c3d4e5-f678-4901-a2b3-c4d5e6f78901",
                        "mediaKey": "fe255933-ffd0-4ab6-9ef7-96bcfe132e09",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Orange USB cables representing connectivity"
                  }
                ]
              },
              {
                "contentTypeKey": "8d2ad68b-931d-453f-9168-af03390dffde",
                "key": "12bcd3e7-9977-4ba8-80d4-0caac2337911",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>With MCP, applications expose their capabilities through a standardized interface. This means an AI agent can discover what tools are available, understand their parameters, and invoke them without needing application-specific code.</p><p>The protocol handles authentication, resource discovery, and tool invocation in a consistent way across all MCP-enabled applications.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "01e6ad04-d828-4205-9adb-e13f406e17cd",
                "key": "39def753-4648-4a54-ade5-bd1efb546e29",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "MCP is the missing link between AI and applications."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "Tech Industry Analyst"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
