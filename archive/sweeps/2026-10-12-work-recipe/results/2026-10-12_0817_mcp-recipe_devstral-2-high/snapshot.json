    {
      "id": "406f6490-b0e2-4c5f-8ed5-5fb90fad02db",
      "name": "MCP Connects AI to Applications",
      "path": "WWW / Blog / MCP Connects AI to Applications",
      "docTypeId": "ed2166e8-07a2-4706-b01e-c37f0c1afc06",
      "templateId": "2ae51c17-3aeb-48d0-9858-01f345883490",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "MCP Connects AI to Applications"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-01 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "How MCP enables AI agents to interact with applications through standardized interfaces."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "a1b2c3d4-e5f6-4789-a1b2-c3d4e5f67890",
