                  "contentKey": "826b33dd-27c8-4a53-8c12-8184bd518f72",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "c885d1bd-a171-42f8-a2e0-8b8c1886b77f",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "9b9a3108-bd7f-4ee2-939c-3b4b45b729b8",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "8d2ad68b-931d-453f-9168-af03390dffde",
                "key": "0aaece11-5b27-4526-9176-c205ef1ca990",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>As AI agents become more capable, they need better ways to interact with the applications we use every day.</p><p>MCP provides a standardized framework that allows applications to expose their functionality to AI agents in a consistent, discoverable way.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "b17419f8-ccc7-4077-9dc5-135b0404fc87",
                "key": "826b33dd-27c8-4a53-8c12-8184bd518f72",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "d5e6f789-0123-4c5d-8012-3456789abcde",
                        "mediaKey": "f7af68fd-83f0-41b0-a4c4-f9c29aab0cf5",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Developer working on code"
                  }
                ]
              },
              {
                "contentTypeKey": "8d2ad68b-931d-453f-9168-af03390dffde",
                "key": "c885d1bd-a171-42f8-a2e0-8b8c1886b77f",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Before MCP, each AI integration required custom development. Developers had to write application-specific adapters for each AI agent, which was time-consuming and error-prone.</p><p>With MCP, developers can expose their application's capabilities once, and any MCP-compatible AI agent can use them immediately.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "01e6ad04-d828-4205-9adb-e13f406e17cd",
                "key": "9b9a3108-bd7f-4ee2-939c-3b4b45b729b8",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "The future of AI is interconnected, and MCP makes it possible."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "AI Researcher"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
