                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Network connections representing MCP integration"
                  }
                ]
              },
              {
                "contentTypeKey": "0d6f22e9-6c6b-4422-af70-94babf2fc812",
                "key": "934aa963-16a2-4695-ba2e-e8209c1b0882",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>The MCP Umbraco server provides tools to create and manage document types, data types, templates, and media. This means you can build entire sites programmatically!</p><p>No more clicking through the backoffice - just describe what you want and the AI agent builds it for you.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
