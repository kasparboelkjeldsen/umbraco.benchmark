      "name": "Why MCP Servers Are Awesome",
      "path": "WWW / Blog / Why MCP Servers Are Awesome",
      "docTypeId": "f4eae049-dd61-49db-9a94-c3c57a8434d6",
      "templateId": "d3aeda7b-4cbf-4699-a42f-514dcb98d7de",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP Servers Are Awesome"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-12 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "MCP servers provide a powerful way to integrate AI agents with your applications"
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
