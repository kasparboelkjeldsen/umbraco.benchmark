                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Umbraco CMS is a powerful content management system built on .NET. With MCP servers, you can now manage your Umbraco content directly from your AI agent.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "c344d85f-999c-485d-85cc-b00d5077132f",
