                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "957e764a-0f45-40a9-bc6a-375d4ab48ffd",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "0d6f22e9-6c6b-4422-af70-94babf2fc812",
                "key": "b89bfab1-5b80-4c63-99fb-7dd1f4f2e7e4",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>MCP (Model Context Protocol) servers are a revolutionary way to connect AI agents to your applications. They provide a standardized interface that allows LLMs to interact with external systems.</p><p>With MCP, you can expose tools, resources, and notifications that AI agents can use to perform complex tasks.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "0d6f22e9-6c6b-4422-af70-94babf2fc812",
                "key": "8182c8e0-6464-4aa5-9f97-b0b0820dfef4",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>In the Umbraco ecosystem, MCP servers allow you to manage content, media, and document types directly from your AI agent. This eliminates the need to manually work through the Umbraco backoffice for every change.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "057bf7bc-05b1-4711-8000-81acd02aa721",
                "key": "794d9d3e-c1c3-4fa7-aac3-6d0f60831779",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "MCP servers are the future of AI integration"
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "Claude Code Team"
                  }
                ]
              },
              {
                "contentTypeKey": "c344d85f-999c-485d-85cc-b00d5077132f",
                "key": "957e764a-0f45-40a9-bc6a-375d4ab48ffd",
