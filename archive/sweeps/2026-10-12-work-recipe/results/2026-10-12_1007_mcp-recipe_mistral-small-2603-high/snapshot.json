    {
      "id": "e8c55693-f975-4282-9726-73e0d647a56c",
      "name": "Blog",
      "path": "WWW / Blog",
      "docTypeId": "7813507a-6351-4526-8e16-ee735fa40bef",
      "templateId": "f6bd564e-e796-481b-92b4-405100f14a5b",
      "state": "Published",
      "domains": [
        {
          "domainName": "/",
          "isoCode": "en-US"
        }
      ],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Welcome to the MCP Blog"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "intro",
          "value": "Discover why MCP (Model-Content-Platform) is transforming how we build modern web applications. This blog explores the architecture, patterns, and benefits of working with MCP in Umbraco."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "6f19996b-9db4-4a8d-877e-a0f601ea78e6",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "8ece1380-7b5c-4ff8-af21-c0405e60812b",
                "key": "6f19996b-9db4-4a8d-877e-a0f601ea78e6",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Welcome to the MCP Blog! This is where we explore the Model-Content-Platform pattern and how it transforms web development in Umbraco.</p><p>MCP helps you build applications that are:</p><ul><li><strong>Reusable</strong>: Components and patterns that work across projects</li><li><strong>Maintainable</strong>: Clean separation of concerns</li><li><strong>Scalable</strong>: Architecture that grows with your needs</li><li><strong>Developer-friendly</strong>: Patterns that make sense and are easy to work with</li></ul><p>Browse our posts below to learn more about MCP and how to apply it in your projects.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "6f19996b-9db4-4a8d-877e-a0f601ea78e6",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
