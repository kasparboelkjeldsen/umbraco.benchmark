    {
      "id": "3611ac13-5abc-445e-93e8-58d23d901e59",
      "name": "Why MCP is Awesome - Part 2",
      "path": "WWW / Blog / Why MCP is Awesome - Part 2",
      "docTypeId": "aef7163d-bca4-4723-8b49-e151a40efe34",
      "templateId": "92df1916-8e03-43b9-8ebb-3285025c5176",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is Awesome - Part 2"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-12 10:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "MCP enables seamless integration between tools and applications, making automation easier than ever."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "726d9436-f5b7-49ad-ae4d-2d1501602334",
