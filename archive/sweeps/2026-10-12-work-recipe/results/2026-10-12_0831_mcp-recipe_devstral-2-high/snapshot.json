              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "bba4d957-1ed8-4e11-9258-922e88328655",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "431c0abe-2f4d-4e26-a469-f41b9a94654a",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "54187ee9-70c1-41ea-a4df-a342bf1e5620",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "1ea393c1-6cb3-4d68-ad60-94af6f244a51",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "6772f1fd-3bd8-4117-9ea1-022445e4bbba",
                "key": "bba4d957-1ed8-4e11-9258-922e88328655",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>In part 2, we dive deeper into the technical aspects of MCP. The protocol is designed to be extensible, allowing developers to add custom capabilities to their applications.</p><p>This extensibility is what makes MCP so powerful - it can adapt to virtually any use case.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "fd36e33b-e800-49ef-b034-8b6d53d06745",
                "key": "431c0abe-2f4d-4e26-a469-f41b9a94654a",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "71829327-f8e0-4b6e-bee3-e433b82f8307",
                        "mediaKey": "41349939-ed21-4c36-93eb-087aed0d5622",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Orange USB cables - connecting systems with MCP"
                  }
                ]
              },
              {
                "contentTypeKey": "6772f1fd-3bd8-4117-9ea1-022445e4bbba",
                "key": "54187ee9-70c1-41ea-a4df-a342bf1e5620",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Whether you're building a simple content management system or a complex enterprise application, MCP provides the tools you need to integrate seamlessly.</p><p>The protocol handles authentication, discovery, and execution, so you can focus on building great features.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "d5138491-02ee-4a51-a6b2-b46c8eacc03d",
                "key": "1ea393c1-6cb3-4d68-ad60-94af6f244a51",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "The beauty of MCP is in its simplicity. Complex integrations become trivial when you have the right abstraction."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "— Developer Advocate"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "bba4d957-1ed8-4e11-9258-922e88328655",
                "culture": null,
                "segment": null
              },
              {
