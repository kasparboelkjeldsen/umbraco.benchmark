    {
      "id": "cf28b660-7ec6-4559-a02b-f10132eccffd",
      "name": "MCP Revolutionizes Content Management",
      "path": "WWW / Blog / MCP Revolutionizes Content Management",
      "docTypeId": "8abd51b0-2a12-4511-9fc4-a93b2d6a3e36",
      "templateId": "d8fbc973-1d1f-4ce5-a90f-23260b0be93d",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "MCP Revolutionizes Content Management"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-12 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "Discover how MCP servers transform the way we manage content in Umbraco and other CMS platforms."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
