      ],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is Awesome"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "intro",
          "value": "Welcome to our blog about MCP servers and how they revolutionize content management."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "a498e1e9-8ea0-47a9-aee4-885740330ac5",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "aba0957b-1107-4de0-ae27-2cbecd2b3f0d",
                "key": "a498e1e9-8ea0-47a9-aee4-885740330ac5",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>MCP (Model Context Protocol) servers provide a standardized way for AI agents to interact with applications and services. They enable seamless integration between AI models and external systems like Umbraco CMS.</p><p>With MCP, you can query content, create pages, upload media, and manage your entire Umbraco site without ever leaving your AI assistant interface.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "a498e1e9-8ea0-47a9-aee4-885740330ac5",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
