      "path": "WWW / Blog / The Power of MCP Servers",
      "docTypeId": "8abd51b0-2a12-4511-9fc4-a93b2d6a3e36",
      "templateId": "d8fbc973-1d1f-4ce5-a90f-23260b0be93d",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "The Power of MCP Servers"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-12 10:00:00"
