                  "contentKey": "f4b8581d-86e7-450c-816d-74cf8c1f4990",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "1ceb0b41-50a7-4314-b277-0347019a94e8",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "aba0957b-1107-4de0-ae27-2cbecd2b3f0d",
                "key": "fe7014a1-4995-4648-9038-2a8a3900f4a6",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>The Model Context Protocol (MCP) is changing how developers and content editors interact with CMS platforms. Gone are the days of complex APIs and custom integrations.</p><p>MCP provides a standardized interface that AI agents can use to perform virtually any content management task, from creating simple pages to managing complex media libraries.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "4f2ba304-3113-4f44-a904-9c6d92bf5b52",
                "key": "799840ce-3716-4e6d-8753-01489a9be785",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "b2c3d4e5-f6a7-4890-b1c2-d3e4f5a6b7c8",
                        "mediaKey": "0f219cff-270e-4183-9e4b-718ec4d762a5",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "Code on screen - the future of development"
                  }
                ]
              },
              {
                "contentTypeKey": "aba0957b-1107-4de0-ae27-2cbecd2b3f0d",
                "key": "f4b8581d-86e7-450c-816d-74cf8c1f4990",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>What makes MCP truly revolutionary is its simplicity. Instead of writing custom code for each integration, you define a set of tools that your application exposes. AI agents can then discover and use these tools through a standardized protocol.</p><p>This means that once you've set up your MCP server for Umbraco, any AI assistant that supports MCP can immediately start managing your content without any additional configuration.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "5b51dd69-5604-4c97-9672-d7880ef9e2c4",
                "key": "1ceb0b41-50a7-4314-b277-0347019a94e8",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "MCP is the missing link between AI and content management systems."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "Tech Industry Analyst"
                  }
                ]
              }
            ],
            "settingsData": [],
