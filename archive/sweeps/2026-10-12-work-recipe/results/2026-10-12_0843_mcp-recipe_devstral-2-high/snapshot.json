        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "Explore how MCP servers enable seamless AI integration with Umbraco and other applications."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
