    {
      "id": "ee0e034e-d385-4bb1-8e5e-7030dbe8e6fd",
      "name": "Blog",
      "path": "WWW / Blog",
      "docTypeId": "b57b8d99-c840-45d4-bd8f-cf06dc6b587f",
      "templateId": "dd5a3003-c3c1-4816-a87e-6494ad5da8a4",
      "state": "Published",
      "domains": [
        {
          "domainName": "/",
          "isoCode": "en-US"
        }
      ],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "MCP is Awesome — A Blog"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "intro",
          "value": "Welcome to our blog about the Model Context Protocol (MCP). We explore how MCP is transforming the way AI agents interact with tools, data, and services."
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "52397779-7c6c-4b56-b490-2f768383aeaa",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "840baff3-d038-4aaf-b905-e24b1a9bc20c",
                "key": "52397779-7c6c-4b56-b490-2f768383aeaa",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Welcome to our first blog post series about the Model Context Protocol — MCP for short. MCP is an open standard that lets AI agents talk to tools, databases, and services through a simple, uniform interface. Think of it as a <em>USB-C for AI</em>: one protocol that replaces a jumble of one-off integrations.</p><p>In the posts below, we explore why MCP matters and how you can build your own MCP server. Whether you are an AI engineer, a tool builder, or just curious about the future of human-AI collaboration, there is something here for you.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "52397779-7c6c-4b56-b490-2f768383aeaa",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/",
        "https://localhost:44317/"
      ],
      "docType": "blogFrontPage",
      "template": "blogFrontPage"
    },
    {
      "id": "4b01923b-0081-4e7d-927b-f7154ef34a67",
      "name": "Why MCP is a Game Changer for AI Agents",
      "path": "WWW / Blog / Why MCP is a Game Changer for AI Agents",
      "docTypeId": "229a78fc-a2c4-40c3-81f6-f4b4154e4034",
      "templateId": "1f64ea6e-ea04-4a7e-8307-38e29aae9432",
      "state": "Published",
      "domains": [],
      "values": [
        {
          "editorAlias": "Umbraco.TextBox",
          "culture": null,
          "segment": null,
          "alias": "title",
          "value": "Why MCP is a Game Changer for AI Agents"
        },
        {
          "editorAlias": "Umbraco.DateTime",
          "culture": null,
          "segment": null,
          "alias": "publishDate",
          "value": "2026-10-01 09:00:00"
        },
        {
          "editorAlias": "Umbraco.TextArea",
          "culture": null,
          "segment": null,
          "alias": "excerpt",
          "value": "The Model Context Protocol (MCP) is transforming how AI agents connect to the world. Say goodbye to brittle, one-off integrations and hello to a universal standard."
        },
        {
          "editorAlias": "Umbraco.MediaPicker3",
          "culture": null,
          "segment": null,
          "alias": "listingImage",
          "value": [
            {
              "key": "51535bc5-30da-4194-8ff9-b16b6bd1ad0b",
              "mediaKey": "54dd747c-4abe-4b5c-8f87-b813a7b4a3f9",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "editorAlias": "Umbraco.BlockGrid",
          "culture": null,
          "segment": null,
          "alias": "body",
          "value": {
            "layout": {
              "Umbraco.BlockGrid": [
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "bab31bfe-7bcf-4531-bb9c-9909e8e81d00",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "5a12cb5d-f99c-453d-b95b-9b95c34a75ea",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "daeafbb0-113f-4791-93c4-7555100dc8d0",
                  "settingsKey": null
                },
                {
                  "$type": "BlockGridLayoutItem",
                  "columnSpan": 12,
                  "rowSpan": 1,
                  "areas": [],
                  "contentKey": "355ad402-ac15-41fb-921a-222f9a10f1bf",
                  "settingsKey": null
                }
              ]
            },
            "contentData": [
              {
                "contentTypeKey": "840baff3-d038-4aaf-b905-e24b1a9bc20c",
                "key": "bab31bfe-7bcf-4531-bb9c-9909e8e81d00",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>Every AI agent today reinvents the wheel when it comes to connecting with external tools. One team builds a custom Slack integration. Another hacks together a database connector. A third wires up a file system access layer. Each is bespoke, each is brittle, and each breaks when the tool's API changes.</p><p>The Model Context Protocol changes all of that. By providing a standard way for AI agents to discover and call tools, MCP means you write an integration once — and every MCP-compatible agent can use it.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "f6f04835-c513-4ccc-8f5d-cb024185c4da",
                "key": "5a12cb5d-f99c-453d-b95b-9b95c34a75ea",
                "values": [
                  {
                    "editorAlias": "Umbraco.MediaPicker3",
                    "culture": null,
                    "segment": null,
                    "alias": "image",
                    "value": [
                      {
                        "key": "6121f4e2-4555-44d4-b8e2-e9b4cefdf1d9",
                        "mediaKey": "b165a9b1-68a6-4feb-8575-6b5626feb5cc",
                        "mediaTypeAlias": "Image",
                        "crops": [],
                        "focalPoint": null
                      }
                    ]
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "caption",
                    "value": "MCP creates a connected ecosystem of tools and agents"
                  }
                ]
              },
              {
                "contentTypeKey": "840baff3-d038-4aaf-b905-e24b1a9bc20c",
                "key": "daeafbb0-113f-4791-93c4-7555100dc8d0",
                "values": [
                  {
                    "editorAlias": "Umbraco.RichText",
                    "culture": null,
                    "segment": null,
                    "alias": "text",
                    "value": {
                      "markup": "<p>What makes MCP truly powerful is its <strong>discoverability</strong>. An MCP server advertises its capabilities — tools, resources, prompts — to any connected client. An agent can ask \"what can you do?\" and get a machine-readable answer. No hard-coded endpoint list. No manual configuration. Just pure, dynamic integration.</p><p>And because MCP is built on a simple JSON-RPC transport, it works everywhere: locally over stdio for tight integration, or remotely over SSE for distributed systems. The same server code powers both.</p>",
                      "blocks": {
                        "layout": {},
                        "contentData": [],
                        "settingsData": [],
                        "expose": []
                      }
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "d1735b0d-4d92-4f30-8bfc-e720238392ee",
                "key": "355ad402-ac15-41fb-921a-222f9a10f1bf",
                "values": [
                  {
                    "editorAlias": "Umbraco.TextArea",
                    "culture": null,
                    "segment": null,
                    "alias": "quote",
                    "value": "MCP is to AI agents what HTTP was to web browsers — a universal protocol that unlocks an ecosystem."
                  },
                  {
                    "editorAlias": "Umbraco.TextBox",
                    "culture": null,
                    "segment": null,
                    "alias": "attribution",
                    "value": "Anthropic, Introducing the Model Context Protocol"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "bab31bfe-7bcf-4531-bb9c-9909e8e81d00",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "5a12cb5d-f99c-453d-b95b-9b95c34a75ea",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "daeafbb0-113f-4791-93c4-7555100dc8d0",
                "culture": null,
                "segment": null
              },
              {
                "contentKey": "355ad402-ac15-41fb-921a-222f9a10f1bf",
                "culture": null,
                "segment": null
              }
            ]
          }
        }
      ],
      "urls": [
        "/why-mcp-is-a-game-changer-for-ai-agents/"
      ],
      "docType": "blogPost",
      "template": "blogPost"
